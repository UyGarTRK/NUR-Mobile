rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /nur_users/{uid}/state/progress {
      function owner() {
        return request.auth != null && request.auth.uid == uid
          && request.auth.token.email_verified == true;
      }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['schema','payload','revision','updatedAt'])
          && d.keys().hasAll(['schema','payload','revision','updatedAt'])
          && d.schema == 2 && d.payload is string && d.payload.size() <= 700000
          && d.revision is int && d.updatedAt == request.time;
      }
      allow get: if owner();
      allow create: if owner() && valid() && request.resource.data.revision == 1;
      allow update: if owner() && valid()
        && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
